{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "../pi-tool-display/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "../pi-tool-display/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "../pi-tool-display/node_modules/@types"
    ],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
