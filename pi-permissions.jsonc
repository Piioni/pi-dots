{
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "allow",
    "skills": "allow",
    "special": "allow"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "todo": "allow",
    "write": "allow",
    "edit": "allow",
    "task": "allow",
    "fetch_content": "allow",
    "ask_user_question": "allow",

    "web_search": "ask",

    "read:**/.env": "deny",
    "read:**/.env.*": "deny",
    "read:**/*.pem": "deny",
    "read:**/*.key": "deny",
    "read:**/*.p12": "deny",
    "read:**/*.jks": "deny",
    "read:**/*.keystore": "deny",
    "read:**/secrets/**": "deny",
    "write:**/.env": "deny",
    "write:**/.env.*": "deny",
    "write:**/*.pem": "deny",
    "write:**/*.key": "deny",
    "write:**/*.p12": "deny",
    "write:**/*.jks": "deny",
    "write:**/*.keystore": "deny",
    "write:**/secrets/**": "deny",
    "edit:**/.env": "deny",
    "edit:**/.env.*": "deny",
    "edit:**/*.pem": "deny",
    "edit:**/*.key": "deny",
    "edit:**/*.p12": "deny",
    "edit:**/*.jks": "deny",
    "edit:**/*.keystore": "deny",
    "edit:**/secrets/**": "deny",
    "read:/home/piioni/.ssh/**": "deny",
    "read:/home/piioni/.gnupg/**": "deny",
    "read:/home/piioni/.aws/**": "deny",
    "read:/home/piioni/.config/gh/**": "deny",
    "read:/home/piioni/.claude/.credentials.json": "deny",
    "read:/home/piioni/.netrc": "deny",
    "read:/home/piioni/.npmrc": "deny",
    "read:/home/piioni/.docker/config.json": "deny",
    "write:/home/piioni/.ssh/**": "deny",
    "write:/home/piioni/.gnupg/**": "deny",
    "write:/home/piioni/.aws/**": "deny",
    "write:/home/piioni/.config/gh/**": "deny",
    "write:/home/piioni/.claude/.credentials.json": "deny",
    "write:/home/piioni/.netrc": "deny",
    "write:/home/piioni/.npmrc": "deny",
    "write:/home/piioni/.docker/config.json": "deny",
    "edit:/home/piioni/.ssh/**": "deny",
    "edit:/home/piioni/.gnupg/**": "deny",
    "edit:/home/piioni/.aws/**": "deny",
    "edit:/home/piioni/.config/gh/**": "deny",
    "edit:/home/piioni/.claude/.credentials.json": "deny",
    "edit:/home/piioni/.netrc": "deny",
    "edit:/home/piioni/.npmrc": "deny",
    "edit:/home/piioni/.docker/config.json": "deny",
    "write:/etc/**": "deny",
    "edit:/etc/**": "deny"
  },
  "bash": {
    "git push *": "ask",
    "git reset --hard *": "ask",
    "git clean *": "ask",
    "git worktree remove *": "ask",
    "rm *": "ask",
    "kill *": "ask",
    "pkill *": "ask",
    "gh pr create *": "ask",
    "gh pr merge *": "ask",
    "gh release *": "ask",
    "sudo*": "deny"
  },
  "mcp": {},
  "skills": {},
  "special": {
    "external_directory:/home/piioni/.ssh/**": "deny",
    "external_directory:/home/piioni/.gnupg/**": "deny",
    "external_directory:/home/piioni/.aws/**": "deny",
    "external_directory:/home/piioni/.config/gh/**": "deny",
    "external_directory:/home/piioni/.claude/.credentials.json": "deny",
    "external_directory:/home/piioni/.netrc": "deny",
    "external_directory:/home/piioni/.npmrc": "deny",
    "external_directory:/home/piioni/.docker/config.json": "deny"
  }
}
