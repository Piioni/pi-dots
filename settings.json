{
  "autocompleteMaxVisible": 5,
  "collapseChangelog": false,
  "compaction": {
    "enabled": true
  },
  "defaultModel": "gpt-5.6-luna",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "enableInstallTelemetry": false,
  "extensions": [
    "/home/piioni/.pi/agent/extensions/piioni-shell"
  ],
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.87.0",
  "markdown": {
    "mermaid": "streaming"
  },
  "outputPad": 1,
  "packages": [
    {
      "extensions": [
        "+extensions/gentle-ai.ts",
        "-extensions/quiet-tools.ts",
        "-extensions/gentle-shell.ts"
      ],
      "prompts": [
        "-prompts/gcl.md",
        "-prompts/gis.md",
        "-prompts/gpr.md",
        "-prompts/gwr.md"
      ],
      "skills": [
        "-skills/branch-pr/SKILL.md",
        "-skills/chained-pr/SKILL.md",
        "-skills/issue-creation/SKILL.md"
      ],
      "source": "npm:gentle-pi@3.3.0",
      "themes": [
        "-themes/Gentle.json"
      ]
    },
    "npm:pi-tool-display",
    {
      "extensions": [
        "+extensions/index.ts"
      ],
      "source": "npm:@hypabolic/pi-hypa"
    },
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@monotykamary/pi-vcc@0.8.6",
    "npm:pi-permission-system",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:pi-btw",
    "npm:pi-figma",
    "npm:gentle-engram@0.1.14",
    "npm:pi-mcp-adapter"
  ],
  "quietStartup": true,
  "showCacheMissNotices": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "theme": "catppuccin-mocha",
  "tuiMode": "fullscreen"
}