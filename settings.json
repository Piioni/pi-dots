{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true
  },
  "steeringMode": "one-at-a-time",
  "hideThinkingBlock": true,
  "collapseChangelog": false,
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "quietStartup": false,
  "theme": "catppuccin-mocha",
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "outputPad": 1,
  "autocompleteMaxVisible": 5,
  "markdown": {
    "mermaid": "streaming"
  },
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "extensions": [
    "/home/piioni/.pi/agent/extensions/piioni-shell",
    "/home/piioni/.pi/agent/extensions/pi-tool-display"
  ],
  "packages": [
    {
      "source": "npm:gentle-pi",
      "extensions": [
        "+extensions/gentle-ai.ts",
        "-extensions/quiet-tools.ts",
        "-extensions/gentle-shell.ts"
      ],
      "prompts": [],
      "skills": [
        "+skills/chained-pr/SKILL.md"
      ],
      "themes": []
    },
    {
      "source": "npm:@hypabolic/pi-hypa",
      "extensions": [
        "+extensions/index.ts"
      ]
    },
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:pi-btw",
    "npm:gentle-engram",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@gotgenes/pi-permission-system@41.0.0"
  ],
  "lastChangelogVersion": "1.0.4"
}
